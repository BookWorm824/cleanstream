{
  "manifest_version": 3,
  "name": "CleanStream",
  "version": "0.4.37",
  "description": "Mutes bad language while videos play on YouTube, Netflix, Prime Video, Hulu and more. Nothing is copied or saved.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CleanStream",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.amazon.com/*",
    "https://www.hulu.com/*",
    "https://www.disneyplus.com/*",
    "https://play.max.com/*",
    "https://www.max.com/*",
    "https://www.peacocktv.com/*",
    "https://www.paramountplus.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hulu.com/*",
        "https://www.disneyplus.com/*",
        "https://play.max.com/*",
        "https://www.max.com/*",
        "https://www.peacocktv.com/*",
        "https://www.paramountplus.com/*"
      ],
      "js": [
        "other_page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.hulu.com/*",
        "https://www.disneyplus.com/*",
        "https://play.max.com/*",
        "https://www.max.com/*",
        "https://www.peacocktv.com/*",
        "https://www.paramountplus.com/*"
      ],
      "js": [
        "words_data.js",
        "words.js",
        "captions.js",
        "settings.js",
        "site_other.js",
        "site.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "netflix_page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "words_data.js",
        "words.js",
        "captions.js",
        "settings.js",
        "site_netflix.js",
        "site.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.com/*/dp/*",
        "https://www.amazon.com/dp/*"
      ],
      "js": [
        "prime_page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.com/*/dp/*",
        "https://www.amazon.com/dp/*"
      ],
      "js": [
        "words_data.js",
        "words.js",
        "captions.js",
        "settings.js",
        "site_prime.js",
        "site.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "words_data.js",
        "words.js",
        "captions.js",
        "settings.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
